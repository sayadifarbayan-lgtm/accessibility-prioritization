# Version control
.git
.github

# Dependencies (must be rebuilt inside the container)
node_modules

# Tests
test

# Build tooling and dev config
Makefile
bower.json
eslint.config.js
.bowerrc
.editorconfig
.markdownlint.jsonc
.npmrc
.nvmrc

# LESS source files (compiled CSS is in public/css)
public/less

# Config files (may contain credentials; samples are kept)
config/development.json
config/production.json
config/test.json

# Documentation
*.md

# Debug logs
npm-debug.log

# --- Added for the production (Railway) image ---

# Spec/IDE/agent working files
.kiro
.vscode
.idea

# Never ship secrets or local state
.env
.env.*
!.env.example
data/overrides.json
data/overrides.json.tmp
backups
*.log

# Only the sample config files are allowed in the image
config/*.json
!config/*.sample.json

# Deployment helper scripts and the example Dockerfile are not needed at runtime
deploy
Dockerfile.example
coverage