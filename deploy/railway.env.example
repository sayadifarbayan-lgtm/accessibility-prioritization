# ======================================================================================
# Railway service variables for the Pa11y Dashboard app service
#
# HOW TO USE
#   Railway -> your app service -> Variables -> "Raw Editor" -> paste the lines you need.
#   Paste ONLY the KEY=value lines: Railway's Raw Editor may reject comment lines. (A clean,
#   comment-free block is also given in DEPLOYMENT.md.)
#   This file contains NO secrets. Replace every <PLACEHOLDER> yourself, in Railway only.
#   Never commit real values to Git.
#
# Lines starting with "#" are comments. Remove the "#" to enable an optional line.
# ======================================================================================

# --------------------------------------------------------------------------------------
# REQUIRED
# --------------------------------------------------------------------------------------

# MongoDB connection. Uses Railway's private network (not exposed to the internet).
#  - "MongoDB" must be the exact name of your MongoDB service on the Railway canvas.
#    (Tip: type  ${{  in the editor and pick the variable from the list.)
#  - "/pa11y" is the DATABASE NAME and is REQUIRED. Without it the app silently uses a
#    database called "test" and your migrated scans would not appear.
#  - "?authSource=admin" is REQUIRED because Railway creates the root user in "admin".
WEBSERVICE_DATABASE=${{MongoDB.MONGO_URL}}/pa11y?authSource=admin

# Access control. The app REFUSES TO START on Railway unless either BASIC_AUTH_* is set
# (below) or READONLY=true is set. See DEPLOYMENT.md "Choose an access mode".
#
# Mode A (recommended for the professor demo): password-protected, everything works,
#         including creating manual priority overrides.
BASIC_AUTH_USER=<USERNAME_TO_GIVE_THE_PROFESSOR>
BASIC_AUTH_PASSWORD=<GENERATED_PASSWORD_AT_LEAST_12_CHARACTERS>

# Mode B (alternative): public, view-only, no password. Comment out the two BASIC_AUTH_*
#         lines above and enable this instead. Scans, edits, deletes and creating
#         overrides are disabled; viewing results, priorities, remediation and
#         comparison still work.
# READONLY=true

# --------------------------------------------------------------------------------------
# OPTIONAL
# --------------------------------------------------------------------------------------

# Only if you attach a Railway Volume (mounted at /data) so manual priority overrides
# survive redeploys. Railway mounts volumes as root, so the app needs to run as root to
# write to it. (Without a volume, overrides are lost on every redeploy.)
# RAILWAY_RUN_UID=0

# Search engines are told not to index the site by default. Leave as is.
# NOINDEX=true

# Nightly scheduled scans. DISABLED by default in this image, because the embedded
# webservice would otherwise scan EVERY task every night at 00:30 UTC and cannot be
# configured off. Enable ONLY if you want that, and keep exactly ONE replica:
# DISABLE_SCHEDULED_SCANS=false
# WEBSERVICE_CRON=0 30 0 * * *

# --------------------------------------------------------------------------------------
# DO NOT SET THESE
# --------------------------------------------------------------------------------------
# PORT                      Railway injects it. The app listens on it automatically.
# WEBSERVICE_HOST / _PORT   Baked into the image (loopback only) so the embedded
#                           webservice is never reachable from outside the container.
# ALLOW_ANONYMOUS_WRITES    Disables the safety check. Never use on a public instance.
# CHROMIUM_EXECUTABLE/FLAGS Baked into the image for the container's Chromium.